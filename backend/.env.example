# Backend Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server port
PORT=3001

# Node environment (development | production)
NODE_ENV=development

# CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:5173

# ============================================
# TON BLOCKCHAIN CONFIGURATION
# ============================================

# TON network (testnet | mainnet)
TON_NETWORK=testnet

# Smart contract address (deploy contract first to get this)
CONTRACT_ADDRESS=

# ============================================
# TELEGRAM BOT CONFIGURATION
# ============================================

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Bot Webhook URL (for production)
# Example: https://yourdomain.com/webhook/telegram
TELEGRAM_WEBHOOK_URL=

# WebApp URL (frontend URL for Telegram WebApp button)
WEBAPP_URL=http://localhost:5173

# ============================================
# COMMISSION CONFIGURATION
# ============================================

# Commission wallet address (hardcoded in smart contract)
# UQDXc5gs_-GAtRpKrcLDoSTMXaSxfxw1_R7xS_wdBdmrhkUj
COMMISSION_WALLET=UQDXc5gs_-GAtRpKrcLDoSTMXaSxfxw1_R7xS_wdBdmrhkUj

# Commission rate (percentage)
COMMISSION_RATE=3

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# API rate limiting (requests per minute)
RATE_LIMIT=100

# Enable debug logging
DEBUG=false

# Database URL (if using database for escrow tracking)
# DATABASE_URL=
