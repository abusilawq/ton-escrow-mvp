# Frontend Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# API CONFIGURATION
# ============================================

# Backend API URL
VITE_API_URL=http://localhost:3001

# ============================================
# TON BLOCKCHAIN CONFIGURATION
# ============================================

# TON network (testnet | mainnet)
VITE_TON_NETWORK=testnet

# Smart contract address (get this after deploying the contract)
VITE_CONTRACT_ADDRESS=

# ============================================
# COMMISSION INFORMATION
# ============================================

# Commission wallet (displayed in UI)
VITE_COMMISSION_WALLET=UQDXc5gs_-GAtRpKrcLDoSTMXaSxfxw1_R7xS_wdBdmrhkUj

# Commission rate percentage
VITE_COMMISSION_RATE=3
